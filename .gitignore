# NOTE: this repo is moving to a private-repo + CI pipeline model (see
# pipeline_config.yaml / build_dataset.py) — the automated pipeline code
# (pipeline/, build_dataset.py, generate_templates.py) and its output
# (data/) MUST be tracked so GitHub Actions can run it. Only truly-local
# scratch/cache files are ignored below.

__pycache__/

# wrangler's local cache/session state (created by `npx wrangler ...`) —
# never committed, may hold account/session data once `wrangler login` runs.
.wrangler/

# Legacy per-month build/patch scripts and their intermediate JSON caches —
# superseded by pipeline/ (see pipeline_config.yaml). Left local until the
# old scripts are fully replaced and removed.
build_*.py
!build_dataset.py
patch_*.py
!patch_async_loader.py
inject_*.py
fix_subdiv_visibility.py
_*.json

# Old duplicate report versions, superseded by index.html
Division Health Card (Standalone).html
Division Health Card (source).html

# Local logs, archives, screenshots
server.log
*.rar
verify_*.png

# Raw source data used only to build index.html locally
uploads/*.html
uploads/*.csv
uploads/*.xlsx
uploads/*.md
uploads/april_2026/
uploads/may_2026/
uploads/new*
uploads/june_2026/*.csv
uploads/june_2026/*.xlsx
uploads/june_2026/POSB/
uploads/July_2026/

# ...except the PLI/RPLI source files that index.html's download links point to
!uploads/june_2026/PLI_June2026_Distribution.xlsx
!uploads/june_2026/PLI_AprToJune2026_Cumulative_Distribution.xlsx
!uploads/june_2026/RPLI_June2026_Distribution.xlsx
!uploads/june_2026/RPLI_AprToJune2026_Cumulative_Distribution.xlsx

# ...and the master office roster — a required pipeline input (see
# pipeline/common.py:Roster), maintained centrally and rarely, not a monthly
# branch upload, but it must reach CI.
!uploads/Hierarchy_data.xlsx

# ...and the office location reference (pincode/lat-long/district/
# constituency/tribal-area) — same deal as the roster above, see
# pipeline/common.py:OfficeGeo.
!uploads/Hierarchy_data_AP_Circle.xlsx
!uploads/AP Circle Hierarchy data containing lat_long.xlsx
